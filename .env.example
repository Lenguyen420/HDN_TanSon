# Khi dev: proxy Vite chuyển API và uploads tới backend Vercel.
# Khi build/chạy trên thiết bị, dùng https://behdntanson.vercel.app/api/v1.
VITE_API_BASE_URL=/api/v1
# Đích proxy chỉ dùng khi dev; API và video uploads cùng một backend.
VITE_API_PROXY_TARGET=https://behdntanson.vercel.app
# Chỉ bật true khi cần xem giao diện với dữ liệu mẫu. Không gửi đăng ký ở chế độ mẫu.
VITE_USE_MOCK_DATA=false

# Bật luồng xác thực Zalo cho Cá nhân, Đăng ký và các thao tác cần quyền.
VITE_ENABLE_ZALO_AUTH=true

# Chế độ xem thử giao thương đang tắt; sử dụng đăng ký/xác thực thật.
VITE_TRADE_PREVIEW=false
