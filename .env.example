# Local: đi qua proxy Vite tới http://localhost:4000 để tránh lỗi CORS.
# Khi build/chạy trên thiết bị, đổi thành https://<backend-domain>/api/v1.
VITE_API_BASE_URL=/api/v1
# Chỉ bật true khi cần xem giao diện với dữ liệu mẫu. Không gửi đăng ký ở chế độ mẫu.
VITE_USE_MOCK_DATA=false

# Tạm tắt bước xác thực Zalo để kiểm tra giao diện trên web. Bật true để khôi phục.
VITE_ENABLE_ZALO_AUTH=false
